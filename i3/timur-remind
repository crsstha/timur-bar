#!/usr/bin/env python3
"""End-of-day nudge for i3: a notification with "Log now" / "Snooze" when little is logged.

  timur-remind         check and notify if needed (run by timur-remind.timer)
  timur-remind --now   notify right away, to try it out

Run every 15 minutes on weekday evenings. It does nothing unless it's past
TIMUR_REMIND_HOUR (17), today has less than TIMUR_REMIND_MINUTES (120) logged,
no ▶ timer is running, and it hasn't already reminded you today (snooze excepted).
Reads the cache only; the refresh timer keeps it current.
"""

import datetime as dt
import json
import os
import subprocess
import sys
from pathlib import Path

CACHE = Path.home() / ".cache/timur-bar"
STATE, TIMER, MARK = CACHE / "state.json", CACHE / "timer.json", CACHE / "remind.json"
HOUR = int(os.environ.get("TIMUR_REMIND_HOUR", "17"))
MINUTES = int(os.environ.get("TIMUR_REMIND_MINUTES", "120"))
SNOOZE_MINUTES = 30
PANEL = Path(__file__).resolve().parent / "timur-panel"


def read_json(path, fallback):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return fallback


def format_minutes(minutes):
    hours, rest = divmod(round(minutes or 0), 60)
    return f"{rest}m" if hours == 0 else f"{hours}h" + (f"{rest:02d}" if rest else "")


def main(argv):
    now = dt.datetime.now()
    today = now.date().isoformat()
    force = "--now" in argv
    mark = read_json(MARK, {})
    if not force and (now.weekday() >= 5 or now.hour < HOUR or TIMER.exists()
                      or (mark.get("date") == today and now.timestamp() < mark.get("until", 0))):
        return 0
    state = read_json(STATE, {})
    day = (state.get("days") or {}).get(today)
    if day is None or state.get("errorKind") == "auth":
        return 0  # stale cache or no session: the bar already shows "!"
    logged = day.get("totalMinutes") or 0
    if logged >= MINUTES and not force:
        return 0

    midnight = dt.datetime.combine(now.date() + dt.timedelta(days=1), dt.time()).timestamp()
    MARK.write_text(json.dumps({"date": today, "until": midnight}))  # once a day unless snoozed
    result = subprocess.run(
        ["notify-send", "--app-name=Timur", "--icon=appointment-new", "--wait",
         "--action=default=Log now", "--action=log=Log now", f"--action=snooze=In {SNOOZE_MINUTES} min",
         "Timur", f"Only {format_minutes(logged)} logged today — log the rest before you forget"],
        capture_output=True, text=True)
    action = result.stdout.strip()
    if action in ("default", "log"):
        subprocess.Popen([str(PANEL)], start_new_session=True)
    elif action == "snooze":
        MARK.write_text(json.dumps({"date": today, "until": now.timestamp() + SNOOZE_MINUTES * 60}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
