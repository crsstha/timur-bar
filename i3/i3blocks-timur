#!/bin/sh
# i3blocks block for Timur: prints the bar text and handles clicks.
#   left: panel · middle: refresh · right: open Timur · scroll up: rofi menu
case "$BLOCK_BUTTON" in
  1) setsid -f "$HOME/.local/bin/timur-panel" >/dev/null 2>&1 ;;
  2) systemctl --user start timur-bar-refresh.service ;;
  3) setsid -f xdg-open https://timur.dev.togglecorp.com/ >/dev/null 2>&1 ;;
  4) setsid -f "$HOME/.local/bin/timur-menu" >/dev/null 2>&1 ;;
esac
exec "$HOME/.local/bin/timur-bar" bar --i3blocks
