# >>> timur-bar >>>
# Timur: Mod+Alt+t log time · Mod+Alt+j journal note · Mod+Alt+e edit/delete entries
bindsym $mod+Mod1+t exec --no-startup-id ~/.local/bin/timur-menu log
bindsym $mod+Mod1+j exec --no-startup-id ~/.local/bin/timur-menu note
bindsym $mod+Mod1+e exec --no-startup-id ~/.local/bin/timur-menu entries
# Let systemd user timers (refresh) reach the X session for notifications
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS
# <<< timur-bar <<<
