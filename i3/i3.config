# >>> timur-bar >>>
# Timur: Super+Alt+t log time · Super+Alt+j journal note · Super+Alt+e edit/delete entries
# Mod4+Mod1 spelled out, not $mod+Mod1: with `set $mod Mod1` that collapses to
# plain Alt+j / Alt+e and clashes with the default focus/layout bindings.
bindsym Mod4+Mod1+t exec --no-startup-id ~/.local/bin/timur-panel
bindsym Mod4+Mod1+j exec --no-startup-id ~/.local/bin/timur-panel journal
bindsym Mod4+Mod1+e exec --no-startup-id ~/.local/bin/timur-panel
# The panel is a popup: float it without a border (it places itself top-right)
for_window [class="^Timur-panel$"] floating enable, border none
# Let systemd user timers (refresh) reach the X session for notifications
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS
# <<< timur-bar <<<
