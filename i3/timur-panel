def capped(child):
    """A scroller around child, sized by set_rows / fit_to_screen (no horizontal scroll).
    Their sizes go in both min and max content height: a non-resizable GTK3 window may take
    its minimum size, and a scroller's own minimum is almost nothing."""
    scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    scroller.set_propagate_natural_height(True)
    scroller.add(child)
    return scroller


def set_rows(scroller, rows, count, spacing=0):
    """Cap scroller at count rows, measured from the first one (fonts differ between setups)."""
    scroller.set_min_content_height(-1)
    if rows:
        height = min(len(rows), count) * (rows[0].get_preferred_height()[1] + spacing)
        scroller.set_max_content_height(max(1, height))
        scroller.set_min_content_height(max(1, height))


def keep_scroll(scroller, rebuild):
    """Run rebuild without the list jumping back to the top."""
    adjustment = scroller.get_vadjustment()
    value = adjustment.get_value()
    rebuild()
    GLib.idle_add(lambda: adjustment.set_value(min(value, adjustment.get_upper() - adjustment.get_page_size())) and False)


