# Slots mixed from the seven, for any theme without them pinned: GTK's mix(a, b, f) = a + f·(b − a).
MIXED = {"banner": "mix(@tb_bg, @tb_accent, 0.12)", "hover": "mix(@tb_bg, @tb_fg, 0.08)",
         "checked": "mix(@tb_bg, @tb_fg, 0.16)", "row": "mix(@tb_bg, @tb_fg, 0.06)",
         "sep": "mix(@tb_bg, @tb_fg, 0.12)", "field_border": "mix(@tb_bg, @tb_fg, 0.22)"}
