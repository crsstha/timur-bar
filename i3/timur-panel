def icon(name, fallback):
    """A theme icon (symbolic ones take the text colour), or fallback text where the theme lacks it."""
    if Gtk.IconTheme.get_default().has_icon(name):
        return Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
    return label(fallback)


def menu_item(icon_name, text):
    item = Gtk.MenuItem()
    box = Gtk.Box(spacing=8)
    if Gtk.IconTheme.get_default().has_icon(icon_name):
        box.pack_start(Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU), False, False, 0)
    box.pack_start(label(text), False, False, 0)
    item.add(box)
    return item


def short_task(text):
    """'MapSwipe › Run Maintenance › RN Upgrade' -> 'MapSwipe › RN Upgrade': project and task fit a meeting line."""
    parts = text.split(" › ")
    return f"{parts[0]} › {parts[-1]}" if len(parts) > 2 else text


def label(text="", *classes, xalign=0.0, ellipsize=None, chars=None, wrap=False):
    widget = Gtk.Label(label=text, xalign=xalign)
    for c in classes:
        widget.get_style_context().add_class(c)
    if ellipsize:
        widget.set_ellipsize(ellipsize)
        widget.set_max_width_chars(1)  # GTK3 otherwise asks for the full text width and stretches the panel
    if chars:
        widget.set_width_chars(chars)
        widget.set_max_width_chars(chars)
    if wrap:
        # Wrap to the width the rest of the panel sets. A wrapping label asks for max_width_chars
        # of width, so anything bigger (a confirmation, a long error) would widen the whole panel.
        widget.set_line_wrap(True)
        widget.set_max_width_chars(1)
    return widget


def set_classes(widget, *classes):
    ctx = widget.get_style_context()
    for c in ("dim", "accent", "urgent"):
        ctx.remove_class(c)
    for c in classes:
        if c:
            ctx.add_class(c)


def toggle_group(options, on_change):
    """Linked buttons acting as one choice (like the panel's ButtonGroup). Returns (box, {value: button})."""
    box = Gtk.Box(spacing=4)
    buttons, first = {}, None
    for value, text in options:
        button = Gtk.RadioButton.new_with_label_from_widget(first, text)
        button.set_mode(False)
        button.connect("toggled", lambda b, v=value: b.get_active() and on_change(v))
        first = first or button
        buttons[value] = button
        box.pack_start(button, False, False, 0)
    return box, buttons


class Panel(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Timur")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)  # i3 floats dialogs
        self.set_default_size(WIDTH, -1)
        self.get_style_context().add_class("timur")

        self.data = {}
        self.day_offset = 0
        self.tab = "entry"
        self.selected_task = ""
        self.entry_type = ""
        self.entry_status = "DONE"
        self.editing_id = ""
        self.editing_task_label = ""
        self.deleted = None  # {"entry", "date"} of the delete in flight
        self.undo = None  # the same once deleted, while Undo is offered
        self.matches = []
        self.busy = False
        self.pending = None
        self.syncing = True  # True while build()/render() set widgets, so their signals don't feed back
        self.fetched = set()  # days asked for since the last good refresh, so a failing fetch doesn't loop
        self.anchor = None  # (monitor right edge, top) the panel's top-right corner sticks to
        self.meeting_picks = {}  # meeting key -> {"on", "duration", "task", "type"} chosen in the Meetings list
        self.meetings_shown = None  # what the Meetings list was built for; rebuilt only when that changes
        self.meeting_rows = {}  # meeting key -> {"row", "check", "task", "type", "duration"} widgets
        self.picking_for = None  # meeting keys (or "ticked") the task search is picking a task for
        self.screen_height = 0  # room below the bar on the panel's monitor, set when it opens
        self.settings_open = False  # the Settings page (⚙ → Appearance…) instead of the tabs
        self.appearance = Appearance(self.on_theme_changed)

        self.build()
        self.syncing = False
        self.connect("key-press-event", self.on_key)
        self.connect("notify::is-active", self.on_active_changed)
        self.connect("delete-event", lambda *a: self.hide() or True)
        self.connect("size-allocate", self.keep_on_monitor)  # width can change as content changes

        self.monitor = Gio.File.new_for_path(str(STATE)).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *a: self.load_state())
        GLib.timeout_add_seconds(30, lambda: self.render() or True)  # keeps "Today" and the hints current
        GLib.timeout_add_seconds(1, lambda: self.render_timer() or True)
        self.load_state()

    # ---------------------------------------------------------------- layout

    def build(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=14)
        body.set_size_request(MIN_WIDTH, -1)  # wrapped text (sign-in help, confirmations) never sets the width

