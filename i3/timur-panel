def find_cli():
    if os.environ.get("TIMUR_BAR_CLI"):
        return os.environ["TIMUR_BAR_CLI"]
    sibling = Path(__file__).resolve().parent.parent / "bin" / "timur-bar"
    return str(sibling) if sibling.exists() else (shutil.which("timur-bar") or "timur-bar")


