DESKTOP_SLOTS = {"bg": "@theme_bg_color", "surface": "@theme_base_color", "fg": "@theme_fg_color",
                 "dim": "mix(@theme_fg_color, @theme_bg_color, 0.4)", "accent": "@theme_selected_bg_color",
                 "urgent": "@error_color", "line": "mix(@theme_fg_color, @theme_bg_color, 0.7)"}


def theme_css(palette):
    """@define-color lines for a palette dict (or None for the desktop's colours)."""
    slots = dict(DESKTOP_SLOTS) if palette is None else {k: palette[k] for k in DESKTOP_SLOTS}
    slots.update({k: v for k, v in MIXED.items()})
    if palette:
        slots.update(palette.get("exact") or {})
    return "".join(f"@define-color tb_{k} {v};\n" for k, v in slots.items()).encode()


def swatch(key, variant):
    """Four colour blocks (background, accent, second accent, warning) — CSS, so no cairo is needed.
    The desktop's use the GTK theme's named colours, so they follow it."""
    palette = THEMES[key][1 if variant == "light" else 2]
    colours = [palette[k] for k in ("bg", "accent", "alt", "urgent")] if palette else \
        ["@theme_bg_color", "@theme_selected_bg_color", "@theme_fg_color", "@error_color"]
    strip = Gtk.Box()
    for colour in colours:
        block = Gtk.Box()
        block.set_size_request(14, 14)
        provider = Gtk.CssProvider()
        provider.load_from_data(f"box {{ background: {colour}; }}".encode())
        block.get_style_context().add_provider(provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        strip.pack_start(block, False, False, 0)
    frame = Gtk.Frame()  # a thin outline, so a background-coloured block still shows
    frame.add(strip)
    return frame


SETTINGS = Path.home() / ".config/timur-bar/settings"  # mode= light= dark= (key=value lines)


def read_settings():
    values = dict(DEFAULT_THEME)
    try:
        for line in SETTINGS.read_text().splitlines():
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip()
    except OSError:
        pass
    if values["mode"] not in ("auto", "light", "dark"):
        values["mode"] = DEFAULT_THEME["mode"]
    for variant in ("light", "dark"):
        if values[variant] not in THEMES:
            values[variant] = DEFAULT_THEME[variant]
    return values


def write_settings(values):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text("".join(f"{k}={values[k]}\n" for k in ("mode", "light", "dark")))


def gtk_theme_installed(name):
    return any((base / name / "gtk-3.0").is_dir() for base in
               (Path.home() / ".themes", Path.home() / ".local/share/themes", Path("/usr/share/themes")))


def theme_sibling(name, dark):
    """The light or dark variant of a GTK theme (Yaru-prussiangreen <-> Yaru-prussiangreen-dark), if installed."""
    base = name[:-5] if name.endswith("-dark") else name
    wanted = f"{base}-dark" if dark else base
    return wanted if wanted == name or gtk_theme_installed(wanted) else None


class Appearance:
    """The panel's theme: colour slots for the chosen light or dark theme, and Auto following the desktop.
    Changes only this panel — the GTK theme swap (for tick boxes and menus) is for this process alone."""

    def __init__(self, on_change):
        self.on_change = on_change
        self.settings = read_settings()
        self.gtk = Gtk.Settings.get_default()
        self.desktop_theme = self.gtk.props.gtk_theme_name
        screen = Gdk.Screen.get_default()
        self.colours, rules = Gtk.CssProvider(), Gtk.CssProvider()
        rules.load_from_data(CSS)
        for provider in (self.colours, rules):
            Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.portal = None
        try:  # the desktop's light/dark setting, on GNOME, KDE, and i3 with xdg-desktop-portal-gtk
            self.portal = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None, "org.freedesktop.portal.Desktop",
                "/org/freedesktop/portal/desktop", "org.freedesktop.portal.Settings", None)
            self.portal.connect("g-signal", self.on_portal_signal)
        except GLib.Error:
            pass
        self.dark, self.key, self.fallback = True, "tokyo-night", False
        self.apply()

    def desktop_dark(self):
        """1 = dark, 2 = light in the portal; with no portal (or no preference) the GTK theme name decides."""
        if self.portal:
            try:
                value = self.portal.call_sync("ReadOne", GLib.Variant("(ss)", ("org.freedesktop.appearance", "color-scheme")),
                                              Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
                if value in (1, 2):
                    return value == 1
            except GLib.Error:
                pass
        return "dark" in self.desktop_theme.lower()

    def on_portal_signal(self, proxy, sender, signal, params):
        if signal == "SettingChanged" and tuple(params.unpack()[:2]) == ("org.freedesktop.appearance", "color-scheme") \
                and self.settings["mode"] == "auto":
            self.apply()
            self.on_change()

    def apply(self):
        mode = self.settings["mode"]
        self.dark = self.desktop_dark() if mode == "auto" else mode == "dark"
        key = self.settings["dark" if self.dark else "light"]
        sibling = theme_sibling(self.desktop_theme, self.dark)
        if sibling and self.gtk.props.gtk_theme_name != sibling:
            self.gtk.props.gtk_theme_name = sibling
        self.fallback = key == "desktop" and not sibling
        self.key = FALLBACK_THEME[self.dark] if self.fallback else key
        self.colours.load_from_data(theme_css(None if self.key == "desktop" else THEMES[self.key][2 if self.dark else 1]))

    def set(self, **values):
        self.settings.update(values)
        write_settings(self.settings)
        self.apply()


def iso(day):
    return day.isoformat()


def format_minutes(minutes):
    minutes = round(minutes or 0)
    hours, rest = divmod(minutes, 60)
    return f"{rest}m" if hours == 0 else f"{hours}h" + (f"{rest:02d}" if rest else "")


def parse_duration(text):
    """Hours by default: 1 · 1.5 · .5 · 2h · 1h30 · 1:30; minutes need 'm': 45m. 0 if invalid or > 24h."""
    s = re.sub(r"\s+", "", str(text or "").lower())
    minutes = 0
    if m := re.fullmatch(r"(\d+):([0-5]\d)", s):
        minutes = int(m[1]) * 60 + int(m[2])
    elif m := re.fullmatch(r"(\d+(?:\.\d+)?)h(?:(\d+)m?)?", s):
        minutes = round(float(m[1]) * 60) + int(m[2] or 0)
    elif m := re.fullmatch(r"(\d+)m", s):
        minutes = int(m[1])
    elif m := re.fullmatch(r"(\d*\.?\d+)", s):
        minutes = round(float(m[1]) * 60)
    return minutes if 0 < minutes <= 24 * 60 else 0


def format_clock(seconds):
    minutes = int(seconds // 60)
    return f"{minutes // 60}:{minutes % 60:02d}"


def read_timer():
    try:
        timer = json.loads(TIMER.read_text())
    except (OSError, ValueError):
        return None
    return timer if timer.get("started") else None


def timer_seconds(timer):
    """Same as timur-bar's: since start, minus pauses."""
    now = dt.datetime.now().timestamp()
    return max(0, (timer.get("pausedAt") or now) - timer["started"] - (timer.get("pausedSeconds") or 0))


def timer_cli(*args):
    """Timer commands are local file updates, quick enough to run on the UI thread."""
    result = subprocess.run([CLI, "timer", *args], capture_output=True, text=True)
    try:
        return json.loads(result.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"ok": False, "error": (result.stderr or "timur-bar timer failed").strip()}


def entry_fields(entry, date):
    """add-entry fields that log the same work as entry on date (copy to today, undo delete)."""
    return {"date": date, "task": str(entry["taskId"]), "type": entry.get("type"),
            "status": entry.get("status") or "DONE", "duration": entry.get("duration") or None,
            "description": entry.get("description") or ""}


def entry_summary(entry):
    return f"{format_minutes(entry['duration']) if entry.get('duration') else entry.get('status') or '?'} · {entry.get('task')}"


