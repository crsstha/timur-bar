    # ---------------------------------------------------------------- state

    @property
    def day_iso(self):
        return iso(dt.date.today() + dt.timedelta(days=self.day_offset))

    @property
    def day_name(self):
        if self.day_offset in (0, -1):
            return "Today" if self.day_offset == 0 else "Yesterday"
        return f"{dt.date.today() + dt.timedelta(days=self.day_offset):%a %d %b}"

    @property
    def day_loaded(self):
        return self.day_iso in (self.data.get("days") or {})

    @property
    def day(self):
        return (self.data.get("days") or {}).get(self.day_iso) or {"entries": [], "totalMinutes": 0, "journal": ""}

    @property
    def duration_required(self):
        return self.entry_status == "DONE"  # TODO / DOING entries can be logged without time

    @property
    def has_data(self):
        return bool(self.data.get("days"))

    @property
    def needs_session(self):
        return self.data.get("errorKind") == "auth"

    @property
    def editing(self):
        return self.editing_id != ""

    def expiry_days(self):
        expire = (self.data.get("me") or {}).get("loginExpire")
        if not expire:
            return 999
        try:
            when = dt.datetime.fromisoformat(expire.replace("Z", "+00:00"))
        except ValueError:
            return 999
        return (when - dt.datetime.now(when.tzinfo)).total_seconds() / 86400

    def task_label_for(self, task_id):
        for t in self.data.get("tasks") or []:
            if str(t["id"]) == str(task_id):
                return t["label"]
        return ""

    def default_type(self):
        keys = [t["key"] for t in self.data.get("types") or []]
        return "DEVELOPMENT" if "DEVELOPMENT" in keys else (keys[0] if keys else "")

    def filter_tasks(self, query):
        recent = [str(r) for r in self.data.get("recentTaskIds") or []]
        words = query.lower().split()
        found = [{"id": str(t["id"]), "label": t["label"], "recent": str(t["id"]) in recent,
                  "rank": recent.index(str(t["id"])) if str(t["id"]) in recent else 9999}
                 for t in self.data.get("tasks") or [] if all(w in t["label"].lower() for w in words)]
        found.sort(key=lambda t: (t["rank"], t["label"].lower()))
        return found[:MAX_TASK_ROWS]

    def load_state(self):
        try:
            self.data = json.loads(STATE.read_text())
        except (OSError, ValueError):
            return
        if not self.entry_type:
            self.entry_type = self.default_type()
        if self.has_data and not self.day_loaded and self.day_iso not in self.fetched:
            self.refresh()  # older days aren't in the cache until asked for
        self.render()

    # ---------------------------------------------------------------- render

    def render(self):
        self.syncing = True
        day = self.day
        self.day_total.set_text(format_minutes(day["totalMinutes"]) if self.has_data else "")

        expiring = not self.needs_session and self.expiry_days() < EXPIRY_WARN_DAYS
        self.session_box.set_visible(self.needs_session or not self.has_data or expiring)
        if self.needs_session or not self.has_data:
            self.session_text.set_text((self.data.get("error") or "Not connected.") +
                                       "\nCopy the __Secure-timur-PROD-sessionid and timur-PROD-csrftoken cookies "
                                       "from the Timur web app (F12 → Application → Cookies).")
            set_classes(self.session_text, "urgent" if self.needs_session else "")
            self.session_button.set_label("Paste session")
        else:
            self.session_text.set_text(f"⚠ Timur session expires in {max(0, int(self.expiry_days()))} day(s) — paste a new one soon.")
            set_classes(self.session_text)
            self.session_button.set_label("Update session")

        self.main_box.set_visible(self.has_data)
        linked = bool(self.data.get("calendar"))
        self.clear_session_item.set_sensitive(self.has_data or not self.needs_session)
        self.clear_calendar_item.set_sensitive(linked)
        self.confirm_box.set_visible(bool(self.confirm))
        if self.confirm:
            self.confirm_text.set_text(CONFIRM[self.confirm][0])
            self.confirm_yes.get_child().set_text(CONFIRM[self.confirm][1])
        self.calendar_link.set_visible(self.has_data)
        self.calendar_link.set_label("Calendar" if linked else "Link calendar")
        self.calendar_link.set_tooltip_text(
            "Link another Google Calendar, or a new secret address" if linked else
            "Link your Google Calendar to log meetings from here (opens a terminal to paste its secret iCal address)")
        self.render_week()
        self.entry_tab.set_visible(self.tab == "entry")
        self.journal_tab.set_visible(self.tab == "journal")

        types = [(t["key"], t["label"]) for t in self.data.get("types") or []]
        if types != getattr(self, "_types", None):
            self._types = types
            self.type_combo.remove_all()
            for key, text in types:
                self.type_combo.append(key, text)
        self.type_combo.set_active_id(self.entry_type or None)
        self.status_buttons.get(self.entry_status, self.status_buttons["DONE"]).set_active(True)
        self.day_button.set_label(self.day_name)
        self.next_day.set_sensitive(self.day_offset < 0)
        self.tab_buttons[self.tab].set_active(True)
        self.syncing = False

        self.render_tasks()
        self.render_form()
        self.render_entries()
        self.render_meetings()
        self.render_journal()
        self.render_timer()
        self.render_settings()
        self.fit_to_screen()

    def render_settings(self):
        self.settings_page.set_visible(self.settings_open)
        if self.settings_open:
            for widget in (self.session_box, self.week_box, self.main_box):
                widget.set_visible(False)
        look = self.appearance
        syncing, self.syncing = self.syncing, True
        self.mode_buttons[look.settings["mode"]].set_active(True)
        for variant in ("light", "dark"):
            self.theme_buttons[(variant, look.settings[variant])].set_active(True)
        self.syncing = syncing
        self.mode_hint.set_text(f"desktop is {'dark' if look.desktop_dark() else 'light'} now"
                                if look.settings["mode"] == "auto" else "")
        sibling = theme_sibling(look.desktop_theme, False), theme_sibling(look.desktop_theme, True)
        for variant, dark in (("light", False), ("dark", True)):
            self.theme_buttons[(variant, "desktop")].set_tooltip_text(
                f"Your desktop theme's colours ({sibling[dark]})" if sibling[dark] else
                f"Your desktop theme has no {variant} variant — {THEMES[FALLBACK_THEME[dark]][0]} is used")

    def open_settings(self, show):
        self.settings_open = show
        self.render()

    def set_theme(self, **values):
        self.appearance.set(**values)
        self.on_theme_changed()

    def on_theme_changed(self):
        self.render()

    def queue_fit(self):
        """fit_to_screen once the current change is done; for updates that don't go through render()."""
        if not getattr(self, "_fit_queued", False):
            self._fit_queued = True
            GLib.idle_add(self.fit_to_screen)

    def fit_to_screen(self):
        """As tall as the content, but never past the bottom of the monitor (it scrolls there)."""
        body = self.outer.get_child()
        natural = body.get_preferred_height_for_width(body.get_preferred_width()[1])[1]  # wrapped labels need a width
        height = min(natural, self.screen_height or natural)
        self.outer.set_min_content_height(-1)
        self.outer.set_max_content_height(height)
        self.outer.set_min_content_height(height)
        self._fit_queued = False
        return False

    def render_timer(self):
        timer = read_timer()
        self.timer_box.set_visible(bool(timer))
        if timer:
            paused = bool(timer.get("pausedAt"))
            self.timer_label.set_text(f"{'⏸' if paused else '▶'} {format_clock(timer_seconds(timer))}  ·  "
                                      f"{timer.get('label') or '?'}")
            self.pause_button.set_label("▶ Resume" if paused else "⏸ Pause")

    def render_week(self):
        """WEEK 21h / 40h   Mo 8h  Tu 7h … — click a day to open it. Weekend days only when logged."""
        week = self.data.get("week") or []
        for child in self.week_box.get_children():
            self.week_box.remove(child)
        self.week_box.set_visible(self.has_data and bool(week))
        total = sum(d["minutes"] for d in week)
        self.week_box.pack_start(label(f"WEEK {format_minutes(total)} / {WEEK_TARGET:g}h", "section",
                                       "accent" if total >= WEEK_TARGET * 60 else ""), False, False, 0)
        today = dt.date.today()
        for d in reversed(week):  # pack_end fills right to left
            day = dt.date.fromisoformat(d["date"])
            if day.weekday() >= 5 and not d["minutes"]:
                continue
            offset = (day - today).days
            button = Gtk.Button(tooltip_text=f"{day:%A %d %b}")
            button.add(label(f"{day:%a}"[:2] + " " + (format_minutes(d["minutes"]) if d["minutes"] else "–"),
                             "accent" if offset == self.day_offset else "dim"))
            button.get_style_context().add_class("flat")
            button.connect("clicked", lambda *a, o=offset: self.set_day(o))
            self.week_box.pack_end(button, False, False, 0)
        self.week_box.show_all()

    def render_tasks(self):
        self.matches = self.filter_tasks(self.task_field.get_text())
        for child in self.task_list.get_children():
            self.task_list.remove(child)
        for t in self.matches:
            row = Gtk.Box(spacing=8)
            chosen = t["id"] == self.selected_task
            row.pack_start(label(("▸ " if chosen else "  ") + t["label"], "accent" if chosen else "",
                                 ellipsize=Pango.EllipsizeMode.MIDDLE), True, True, 0)
            row.pack_end(label("recent" if t["recent"] else "", "dim"), False, False, 0)
            self.task_list.add(row)
        self.task_list.show_all()
        if self.matches:
            self.task_list.select_row(self.task_list.get_row_at_index(0))
        self.no_tasks.set_visible(not self.matches)

    def render_form(self):
        selected = self.task_label_for(self.selected_task) or (self.editing_task_label if self.editing else "")
        self.task_label.set_text("TASK" + (f"   ·   {selected}" if selected else ""))
        self.edit_banner.set_visible(self.editing)
        self.queue_fit()
        self.pick_banner.set_visible(bool(self.picking_for))
        if self.picking_for:
            titles = [m["title"] for m in self.visible_meetings() if m["key"] in self.picking_keys()]
            self.pick_banner.set_text(f"Picking a task for: {', '.join(titles) or 'nothing'} — Enter picks, Esc cancels")
        self.cancel_button.set_visible(self.editing)
        self.undo_button.set_visible(bool(self.undo) and not self.busy)
        self.start_button.set_visible(not self.editing and self.day_offset == 0 and not read_timer())
        self.start_button.set_sensitive(not self.busy and bool(self.selected_task) and bool(self.entry_type))

        text = self.duration_field.get_text().strip()
        minutes = parse_duration(text)
        optional = "" if self.duration_required else "  (optional for " + self.entry_status + ")"
        self.duration_label.set_text("DURATION" + ((("  = " + format_minutes(minutes)) if minutes else "  ?") if text else optional))
        set_classes(self.duration_label, "urgent" if text and not minutes else "")
        self.duration_field.set_placeholder_text("hrs, e.g. 1.5" if self.duration_required else "leave empty")
        duration_ok = minutes > 0 if text or self.duration_required else True
        self.save_button.set_label("Saving…" if self.busy else ("Update" if self.editing else
                                                                 "Save" if self.duration_required else f"Add {self.entry_status}"))
        self.save_button.set_sensitive(not self.busy and bool(self.selected_task) and bool(self.entry_type) and duration_ok)

    def render_entries(self):
        keep_scroll(self.entries_scroll, self.build_entry_rows)

    def build_entry_rows(self):
        day = self.day
        timed = any(e.get("startTime") for e in day.get("entries") or [])  # meetings logged from the calendar
        self.logged_label.set_text(f"LOGGED {self.day_name.upper()}")
        self.logged_total.set_text(format_minutes(day["totalMinutes"]))
        for child in self.entries_list.get_children():
            self.entries_list.remove(child)
        for entry in day.get("entries") or []:
            cid = entry.get("clientId") or ""
            editing = self.editing and cid == self.editing_id
            box = Gtk.Box(spacing=12)
            status = entry.get("status") or "DONE"
            if timed:
                box.pack_start(label((entry.get("startTime") or "")[:5], "dim", chars=5), False, False, 0)
            box.pack_start(label(format_minutes(entry["duration"]) if entry.get("duration") else "—",
                                 "dim", xalign=1.0, chars=4 if timed else 6), False, False, 0)
            box.pack_start(label(entry.get("task") or "?", "accent" if editing else "",
                                 ellipsize=Pango.EllipsizeMode.MIDDLE, chars=20), False, False, 0)
            if status != "DONE":
                box.pack_start(label(status, "urgent" if status == "TODO" else "accent"), False, False, 0)
            box.pack_start(label(entry.get("description") or "", "dim", ellipsize=Pango.EllipsizeMode.END), True, True, 0)
            if cid and not self.busy:
                actions = [("Edit", lambda *a, e=entry: self.start_edit(e), ""),
                           ("Delete", lambda *a, e=entry: self.delete_entry(e), "urgent")]  # no confirm: Undo instead
                if status != "DONE":
                    actions.insert(0, ("✓ Done", lambda *a, e=entry: self.start_edit(e, "DONE"), "accent"))
                if self.day_offset != 0 and entry.get("taskId"):
                    actions.insert(0, ("→ Today", lambda *a, e=entry: self.copy_to_today(e), ""))
                for text, handler, cls in reversed(actions):  # pack_end fills right to left
                    button = Gtk.Button()
                    button.add(label(text, cls))
                    button.get_style_context().add_class("flat")
                    button.connect("clicked", handler)
                    box.pack_end(button, False, False, 0)
            row = Gtk.ListBoxRow()
            row.add(box)
            if editing:
                row.get_style_context().add_class("editing")
            self.entries_list.add(row)
        self.entries_list.show_all()
        set_rows(self.entries_scroll, self.entries_list.get_children(), ENTRY_ROWS)
        self.nothing_logged.set_text("Nothing logged yet" if self.day_loaded else "Loading…")
        self.nothing_logged.set_visible(not day.get("entries"))
        repeat = self.repeatable()
        self.repeat_button.set_visible(bool(repeat) and not self.busy)
        if repeat:
            name = "yesterday" if repeat[0] == iso(dt.date.today() - dt.timedelta(days=1)) else \
                f"{dt.date.fromisoformat(repeat[0]):%A}"
            minutes = sum(e.get("duration") or 0 for e in repeat[1])
            self.repeat_button.set_label(f"⟳ Repeat {name}  ({len(repeat[1])} entries · {format_minutes(minutes)})")

    def visible_meetings(self):
        """The day's meetings not logged yet, upcoming ones too (they start unticked)."""
        return list(self.day.get("meetings") or [])

    def meeting_pick(self, meeting):
        """Choices for a meeting row; the first time, from what was used for it before. A meeting
        still going on starts unticked, and so does one with no task yet."""
        if meeting["key"] not in self.meeting_picks:
            suggest = meeting.get("suggest") or {}
            ended = dt.datetime.fromisoformat(meeting["end"]) <= dt.datetime.now().astimezone()
            self.meeting_picks[meeting["key"]] = {
                "on": ended and bool(suggest.get("task")), "duration": format_minutes(meeting["minutes"]),
                "task": str(suggest.get("task") or ""), "type": suggest.get("type") or self.meeting_type(suggest.get("task"))}
        return self.meeting_picks[meeting["key"]]

    def meeting_type(self, task_id):
        keys = [t["key"] for t in self.data.get("types") or []]
        last = (self.data.get("lastTypeByTask") or {}).get(str(task_id or ""))
        return last or ("INTERNAL_MEETING" if "INTERNAL_MEETING" in keys else self.default_type())

    def render_meetings(self):
        meetings = self.visible_meetings()
        error = self.data.get("calendarError") or ""
        hidden = self.hidden_meetings()
        self.meetings_box.set_visible(bool(self.data.get("calendar")) and bool(meetings or error or hidden))
        self.render_hidden(hidden)
        self.calendar_error.set_visible(bool(error))
        self.calendar_button.set_visible(bool(error))
        self.calendar_error.set_text(f"Calendar: {error}" if error else "")
        self.meetings_label.set_text(f"MEETINGS · {len(meetings)} TO LOG" if meetings else "MEETINGS")
        shown = (tuple(m["key"] for m in meetings), tuple(self.data.get("recentTaskIds") or []),
                 len(self.data.get("types") or []))
        if shown != self.meetings_shown:
            self.meetings_shown = shown
            keep_scroll(self.meetings_scroll, lambda: self.build_meeting_rows(meetings))
        self.render_meetings_button()

    def hidden_meetings(self):
        """The day's meetings marked as not work (✕), which can be restored."""
        return list(self.day.get("hidden") or [])

    def render_hidden(self, hidden):
        """The "N hidden" toggle in the Meetings header, and the list it opens with ↶ Restore per meeting."""
        self.hidden_button.set_visible(bool(hidden))
        self.hidden_button.get_child().set_text(f"{len(hidden)} hidden")
        if not hidden and self.hidden_button.get_active():
            syncing, self.syncing = self.syncing, True
            self.hidden_button.set_active(False)
            self.syncing = syncing
        self.hidden_list.set_visible(bool(hidden) and self.hidden_button.get_active())
        if [m["key"] for m in hidden] == getattr(self, "_hidden_shown", None):
            return
        self._hidden_shown = [m["key"] for m in hidden]
        for child in self.hidden_rows.get_children():
            self.hidden_rows.remove(child)
        for meeting in hidden:
            row = Gtk.Box(spacing=6)
            row.pack_start(label(f"{dt.datetime.fromisoformat(meeting['start']):%H:%M}", "dim"), False, False, 0)
            row.pack_start(label(meeting["title"], "dim", ellipsize=Pango.EllipsizeMode.END), True, True, 0)
            restore = Gtk.Button(tooltip_text="Offer this meeting, and ones with the same title, again on every day")
            restore.get_style_context().add_class("flat")
            restore.add(label("↶ Restore", "accent"))
            restore.connect("clicked", lambda *a, m=meeting: self.restore_meeting(m))
            row.pack_end(restore, False, False, 0)
            self.hidden_rows.pack_start(row, False, False, 0)
        self.hidden_rows.show_all()
        self.queue_fit()

    def build_meeting_rows(self, meetings):
        """One line per meeting:  ☑ 10:00 Standup  [30m] […RN Upgrade ▾] [Meet·I] ✕"""
        for child in self.meetings_list.get_children():
            self.meetings_list.remove(child)
        self.meeting_rows = {}
        types = [(t["key"], t["label"]) for t in self.data.get("types") or []]
        latest_end = None
        for meeting in meetings:
            pick = self.meeting_pick(meeting)
            start, end = dt.datetime.fromisoformat(meeting["start"]), dt.datetime.fromisoformat(meeting["end"])
            overlaps = latest_end is not None and start < latest_end[0]
            row = Gtk.Box(spacing=4)
            check = Gtk.CheckButton(active=pick["on"])
            check.connect("toggled", lambda b, p=pick: p.update(on=b.get_active()) or self.render_meetings_button())
            row.pack_start(check, False, False, 0)
            row.pack_start(label(f"{start:%H:%M}", "urgent" if overlaps else "dim"), False, False, 0)
            title = label(meeting["title"], ellipsize=Pango.EllipsizeMode.END)
            title.set_width_chars(12)  # at least "Frontend tea…"; the panel grows a little for it
            title.set_tooltip_text(f"{meeting['title']}\n{start:%H:%M}–{end:%H:%M}" +
                                   (f"\n⚠ Overlaps {latest_end[1]} — shorten one of them" if overlaps else ""))
            row.pack_start(title, True, True, 0)

            duration = Gtk.Entry(text=pick["duration"], width_chars=4, max_width_chars=4,
                                 tooltip_text="Time to log (e.g. 30m, 1h, 1.5)")
            duration.get_style_context().add_class("compact")
            duration.connect("changed", self.on_meeting_duration, pick)
            row.pack_start(duration, False, False, 0)

            task_button = Gtk.Button()  # opens the TASK search above: recent tasks, one click, or type
            task_button.get_style_context().add_class("compact")
            task_button.add(label("", ellipsize=Pango.EllipsizeMode.MIDDLE, chars=18))
            task_button.connect("clicked", lambda *a, k=meeting["key"]: self.start_task_search([k]))
            row.pack_start(task_button, False, False, 0)

            type_button = Gtk.MenuButton(tooltip_text=self.type_label(pick["type"]))
            type_button.get_style_context().add_class("compact")
            type_button.add(label(short_type(self.type_label(pick["type"])), "dim", chars=6))  # same width in every row
            menu = Gtk.Menu()
            for key, text in types:
                item = Gtk.MenuItem(label=text)
                item.connect("activate", lambda i, k=key, b=type_button, p=pick: self.set_meeting_type(p, b, k))
                menu.append(item)
            menu.show_all()
            type_button.set_popup(menu)
            row.pack_start(type_button, False, False, 0)

            dismiss = Gtk.Button(label="✕", tooltip_text="Not work — hide it, and meetings with the same title, every day (restore from “hidden” next to MEETINGS)")
            dismiss.get_style_context().add_class("flat")
            dismiss.connect("clicked", lambda *a, m=meeting: self.dismiss_meeting(m))
            row.pack_start(dismiss, False, False, 0)
            self.meetings_list.pack_start(row, False, False, 0)
            widgets = {"row": row, "check": check, "task": task_button, "type": type_button, "duration": duration}
            self.meeting_rows[meeting["key"]] = widgets
            self.show_meeting_task(widgets, pick["task"])
            if latest_end is None or end > latest_end[0]:
                latest_end = (end, meeting["title"])
        self.meetings_list.show_all()
        set_rows(self.meetings_scroll, self.meetings_list.get_children(), MEETING_ROWS, spacing=2)

    def show_meeting_task(self, widgets, task_id):
        full = self.task_label_for(task_id)
        widgets["task"].get_child().set_text(short_task(full) if full else "Choose task…")
        set_classes(widgets["task"].get_child(), "" if full else "dim")
        widgets["task"].set_tooltip_text(f"{full}\nClick to change" if full else "Click to pick a task")

    @property
    def meeting_combos(self):
        """Type menus of the Meetings list, so an open one doesn't close the panel."""
        return [w["type"] for w in self.meeting_rows.values()]

    def set_meeting_type(self, pick, button, key):
        pick["type"] = key
        text = self.type_label(key)
        button.get_child().set_text(short_type(text))
        button.set_tooltip_text(text)
        self.render_meetings_button()

    def type_label(self, key):
        return next((t["label"] for t in self.data.get("types") or [] if t["key"] == key), key or "Type")

    def on_meeting_duration(self, entry, pick):
        pick["duration"] = entry.get_text()
        entry.get_style_context().remove_class("problem")
        self.render_meetings_button()

    def set_meeting_task(self, key, task_id):
        """Choosing a task ticks the meeting and brings that task's usual type."""
        pick, widgets = self.meeting_picks[key], self.meeting_rows.get(key)
        pick["task"] = task_id
        if not widgets:
            return
        self.show_meeting_task(widgets, task_id)
        widgets["task"].get_style_context().remove_class("problem")
        if task_id:
            self.set_meeting_type(pick, widgets["type"], self.meeting_type(task_id))
            widgets["check"].set_active(True)
        self.render_meetings_button()

    def on_all_toggled(self, check):
        if self.syncing:
            return
        for widgets in self.meeting_rows.values():
            widgets["check"].set_active(check.get_active())

    def ticked_without_task(self):
        return [m["key"] for m, p in self.chosen_meetings() if not p["task"]]

    def picking_keys(self):
        return self.ticked_without_task() if self.picking_for == "ticked" else self.picking_for or []

    def start_task_search(self, keys):
        """Use the TASK search above to pick a task for these meetings (Enter / click picks, Esc cancels)."""
        self.picking_for = keys
        self.task_field.set_text("")
        self.render_form()
        self.task_field.grab_focus()

    def stop_task_search(self):
        self.picking_for = None
        self.task_field.set_text("")
        self.render()

    def chosen_meetings(self):
        return [(m, self.meeting_picks[m["key"]]) for m in self.visible_meetings()
                if self.meeting_picks.get(m["key"], {}).get("on")]

    def meeting_problems(self):
        """Ticked meetings that can't be logged yet: [(key, "task" | "duration")], top to bottom."""
        return [(m["key"], "task" if not (p["task"] and p["type"]) else "duration")
                for m, p in self.chosen_meetings()
                if not (p["task"] and p["type"]) or not parse_duration(p["duration"])]

    def render_meetings_button(self):
        chosen, problems = self.chosen_meetings(), self.meeting_problems()
        no_task = sum(kind == "task" for _, kind in problems)
        bad_time = len(problems) - no_task
        text = f"Log {len(chosen)}" if chosen else "Log"
        if no_task:
            text += f" · {no_task} need{'s' if no_task == 1 else ''} a task"
        elif bad_time:
            text += f" · {bad_time} need{'s' if bad_time == 1 else ''} a time"
        self.log_meetings_button.set_label("Saving…" if self.busy else text)
        self.log_meetings_button.set_sensitive(not self.busy and bool(chosen))
        self.log_meetings_button.set_tooltip_text(
            "Show the first meeting that needs fixing" if problems else "Log the ticked meetings as DONE entries")

        rows = self.meeting_rows
        self.bulk_row.set_visible(len(rows) > 1)
        syncing, self.syncing = self.syncing, True
        self.all_check.set_active(bool(rows) and all(w["check"].get_active() for w in rows.values()))
        missing = len(self.ticked_without_task())
        self.bulk_task.set_label(f"Choose task for {missing} ticked…")
        self.bulk_task.set_visible(missing > 0)
        self.queue_fit()
        self.syncing = syncing

    def render_journal(self):
        possessive = f"{self.day_name.upper()}'S"
        self.journal_add_label.set_text(f"ADD TO {possessive} JOURNAL")
        self.journal_label.set_text(f"{possessive} JOURNAL")
        journal = self.day.get("journal") or ""
        buffer = self.journal_view.get_buffer()
        if buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False) != (journal or "Empty"):
            buffer.set_text(journal or "Empty")
            GLib.idle_add(lambda: self.journal_view.scroll_to_iter(buffer.get_end_iter(), 0, False, 0, 0) and False)
        set_classes(self.journal_view, "" if journal else "dim")
        self.render_journal_hint()

    def render_journal_hint(self, message=None, kind=""):
        text = self.note_field.get_text().strip()
        if message is None:
            message = f"Will be added as:  - {dt.datetime.now():%H:%M} {text}" if text else ""
            kind = "dim"
        self.journal_message.set_text(message)
        set_classes(self.journal_message, {"ok": "accent", "error": "urgent", "auth": "urgent"}.get(kind, kind))
        self.add_button.set_label("Saving…" if self.busy else "Add line")
        self.add_button.set_sensitive(not self.busy and bool(text))

    def show_message(self, text, kind=""):
        if self.tab == "journal":
            self.render_journal_hint(text, kind)
            return
        self.entry_message.set_text(text)
        self.queue_fit()
        set_classes(self.entry_message, {"ok": "accent", "error": "urgent", "auth": "urgent"}.get(kind, ""))

    # ---------------------------------------------------------------- handlers

    def set_day(self, offset):
        offset = min(offset, 0)
        if self.syncing or offset == self.day_offset:
            return
        self.day_offset = offset
        self.cancel_edit()
        if self.has_data and not self.day_loaded:
            self.refresh()
        self.render()

    def set_tab(self, tab):
        if self.syncing:
            return
        self.tab = tab
        self.render()
        self.focus_tab()

    def set_status(self, status):
        if not self.syncing:
            self.entry_status = status
            self.render_form()

    def set_duration(self, text):
        self.duration_field.set_text(text)
        self.description_field.grab_focus()

    def on_type_changed(self, combo):
        if not self.syncing and combo.get_active_id():
            self.entry_type = combo.get_active_id()
            self.render_form()

    def focus_tab(self):
        (self.task_field if self.tab == "entry" else self.note_field).grab_focus()

    def pick_task(self, task_id):
        if self.picking_for:
            for key in self.picking_keys():
                self.set_meeting_task(key, task_id)
            return self.stop_task_search()
        self.selected_task = task_id
        last = (self.data.get("lastTypeByTask") or {}).get(task_id)
        self.entry_type = last or self.entry_type or self.default_type()
        self.render()
        self.duration_field.grab_focus()

    def on_task_key(self, widget, event):
        rows = len(self.matches)
        current = self.task_list.get_selected_row()
        index = current.get_index() if current else 0
        if event.keyval == Gdk.KEY_Down and rows:
            self.task_list.select_row(self.task_list.get_row_at_index(min(index + 1, rows - 1)))
            return True
        if event.keyval == Gdk.KEY_Up and rows:
            self.task_list.select_row(self.task_list.get_row_at_index(max(index - 1, 0)))
            return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and not event.state & Gdk.ModifierType.CONTROL_MASK:
            if rows:
                self.pick_task(self.matches[index]["id"])
            return True
        return False

    def on_key(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            if self.settings_open:
                self.open_settings(False)
            elif self.confirm:
                self.ask_confirm(None)
            elif self.picking_for:
                self.stop_task_search()
            elif self.editing:
                self.cancel_edit()
            else:
                self.hide()
            return True
        if event.state & Gdk.ModifierType.CONTROL_MASK and event.keyval in (Gdk.KEY_Page_Up, Gdk.KEY_Page_Down, Gdk.KEY_Home):
            self.set_day({Gdk.KEY_Page_Up: self.day_offset - 1, Gdk.KEY_Page_Down: self.day_offset + 1}.get(event.keyval, 0))
            return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and event.state & Gdk.ModifierType.CONTROL_MASK:
            self.save_entry() if self.tab == "entry" else self.add_note()
            return True
        return False

    def on_active_changed(self, *args):
        # Close when focus moves elsewhere, like a popup. The delay lets the Type dropdown open without closing us.
        if not self.is_active():
            GLib.timeout_add(200, self.hide_if_inactive)

    def hide_if_inactive(self):
        popup = any(c.props.popup_shown if isinstance(c, Gtk.ComboBox) else c.get_active()
                    for c in [self.type_combo, self.settings, *self.meeting_combos])
        if not self.is_active() and not popup and self.get_visible():
            self.hide()
        return False

    # ---------------------------------------------------------------- actions

    def save_entry(self):
        text = self.duration_field.get_text().strip()
        minutes = parse_duration(text)
        if not self.selected_task:
            return self.show_message("Pick a task first", "error")
        if not minutes and (text or self.duration_required):
            return self.show_message("Enter a duration in hours, like 1, 1.5 or 0.25 (or 45m)"
                                     + ("" if text else " — or set status to TODO to skip it"), "error")
        if self.busy or not self.entry_type:
            return
        fields = {"date": self.day_iso, "task": self.selected_task, "type": self.entry_type,
                  "status": self.entry_status, "duration": minutes or None,
                  "description": self.description_field.get_text().strip()}
        if self.editing:
            fields["clientId"] = self.editing_id
            self.run_cli(["update-entry", json.dumps(fields)], "update")
        else:
            self.run_cli(["add-entry", json.dumps(fields)], "entry")

    def start_edit(self, entry, status=None):
        """Load an entry into the form. status="DONE" is the "✓ Done" shortcut for TODO/DOING entries."""
        self.editing_id = entry.get("clientId") or ""
        self.editing_task_label = entry.get("task") or ""
        self.selected_task = str(entry.get("taskId") or "")
        self.entry_type = entry.get("type") or self.default_type()
        self.entry_status = status or entry.get("status") or "DONE"
        self.duration_field.set_text(format_minutes(entry["duration"]) if entry.get("duration") else "")
        self.description_field.set_text(entry.get("description") or "")
        self.task_field.set_text("")
        self.show_message("How long did it take?" if status and not entry.get("duration") else "")
        self.render()
        (self.duration_field if status and not entry.get("duration") else self.description_field).grab_focus()

    def cancel_edit(self):
        if not self.editing:
            return
        self.editing_id = self.editing_task_label = self.selected_task = ""
        self.entry_status = "DONE"
        self.duration_field.set_text("")
        self.description_field.set_text("")
        self.show_message("")
        self.render()

    def delete_entry(self, entry):
        if self.editing_id == entry.get("clientId"):
            self.cancel_edit()
        self.deleted = {"entry": entry, "date": self.day_iso}
        self.run_cli(["delete-entry", entry["clientId"], self.day_iso], "delete", entry_summary(entry))

    def undo_delete(self):
        """Log the deleted entry again (it gets a new id; same task, type, status, time, description)."""
        if self.undo and not self.busy:
            entry, date = self.undo["entry"], self.undo["date"]
            self.run_cli(["add-entry", json.dumps(entry_fields(entry, date))], "undo", entry_summary(entry))

    def expire_undo(self, undo):
        if self.undo is undo:
            self.undo = None
            self.render_form()
        return False

    def repeatable(self):
        """(date, entries) of the last earlier day's DONE entries, offered while today is empty."""
        previous = self.data.get("previousDay")
        if self.day_offset != 0 or not self.day_loaded or self.day.get("entries") or not previous:
            return None
        entries = [e for e in ((self.data.get("days") or {}).get(previous) or {}).get("entries") or []
                   if e.get("taskId") and (e.get("status") or "DONE") == "DONE"]  # Timur moves TODOs itself
        return (previous, entries) if entries else None

    def repeat_previous_day(self):
        repeat = self.repeatable()
        if repeat and not self.busy:
            today = iso(dt.date.today())
            fields = [{**entry_fields(e, today), "type": e.get("type") or self.default_type()} for e in repeat[1]]
            self.run_cli(["add-entry", json.dumps(fields)], "repeat", f"{len(fields)} entries")

    def copy_to_today(self, entry):
        """Log the same work again today (task, type, status, duration, description)."""
        fields = entry_fields(entry, iso(dt.date.today()))
        fields["type"] = fields["type"] or self.default_type()
        self.run_cli(["add-entry", json.dumps(fields)], "copy", entry_summary(entry))

    def start_timer(self):
        if not self.selected_task or read_timer():
            return
        result = timer_cli("start", json.dumps({
            "task": self.selected_task, "label": self.task_label_for(self.selected_task), "type": self.entry_type,
            "description": self.description_field.get_text().strip()}))
        if not result.get("ok"):
            return self.show_message(result.get("error") or "Timer failed", "error")
        self.selected_task = ""
        self.description_field.set_text("")
        self.duration_field.set_text("")
        self.show_message("▶ Timer started — it keeps running with the panel closed", "ok")
        self.render()

    def pause_timer(self):
        timer = read_timer()
        if timer:
            timer_cli("resume" if timer.get("pausedAt") else "pause")
        self.render()

    def stop_timer(self):
        """Fill the form from the timer (duration rounded to the minute) so you can check it and Save."""
        result = timer_cli("stop")
        if not result.get("ok"):
            return self.render()
        timer = result["timer"]
        self.cancel_edit()
        self.set_day(0)
        minutes = timer["minutes"]
        self.selected_task = str(timer["task"])
        self.entry_type = timer.get("type") or self.default_type()
        self.entry_status = "DONE"
        self.duration_field.set_text(format_minutes(minutes))
        self.description_field.set_text(timer.get("description") or "")
        self.show_message(f"■ Stopped at {format_minutes(minutes)} — add a description and Save")
        self.render()
        self.description_field.grab_focus()

    def discard_timer(self):
        timer_cli("discard")
        self.show_message("Timer discarded")
        self.render()

    def log_meetings(self):
        chosen = self.chosen_meetings()
        if self.busy or not chosen:
            return
        problems = self.meeting_problems()
        if problems:
            return self.show_meeting_problem(*problems[0])
        fields = [{"date": self.day_iso, "task": p["task"], "type": p["type"], "status": "DONE",
                   "duration": parse_duration(p["duration"]), "description": m["title"],
                   "startTime": m["start"][11:16] + ":00", "uid": m["uid"], "title": m["title"]} for m, p in chosen]
        self.run_cli(["log-meetings", json.dumps(fields)], "meetings",
                     f"{len(fields)} meeting{'s' if len(fields) > 1 else ''}")

    def show_meeting_problem(self, key, kind):
        """Scroll the Meetings list to the first ticked meeting that can't be logged and outline what's missing."""
        widgets = self.meeting_rows[key]
        widget = widgets["task"] if kind == "task" else widgets["duration"]
        widget.get_style_context().add_class("problem")
        y = widgets["row"].translate_coordinates(self.meetings_list, 0, 0)[1]
        self.meetings_scroll.get_vadjustment().set_value(max(0, y - 4))
        widget.grab_focus()
        title = next(m["title"] for m in self.visible_meetings() if m["key"] == key)
        self.show_message(f"“{title}” needs a {'task' if kind == 'task' else 'time, like 30m or 1h'}", "error")

    def dismiss_meeting(self, meeting):
        """Local only (no network), so it runs right here; state.json changes and the list follows."""
        subprocess.run([CLI, "dismiss-meeting", meeting["key"]], capture_output=True)
        self.meeting_picks.pop(meeting["key"], None)
        self.load_state()
        self.show_message(f"Hidden “{meeting['title']}” and same-titled meetings on every day — “hidden” next to MEETINGS brings them back")

    def restore_meeting(self, meeting):
        subprocess.run([CLI, "restore-meeting", meeting["key"]], capture_output=True)
        self.load_state()
        self.show_message(f"✓ “{meeting['title']}” and same-titled meetings are back on every day", "ok")

    def ask_confirm(self, action):
        """Show (or with None, dismiss) the confirmation banner for a ⚙ action."""
        self.confirm = action
        self.render()
        if action:
            self.confirm_yes.grab_focus()

    def confirmed(self):
        action, self.confirm = self.confirm, None
        result = subprocess.run([CLI, f"clear-{action}"], capture_output=True, text=True)
        ok = result.returncode == 0
        if action == "calendar":
            self.meeting_picks, self.meetings_shown, self.picking_for = {}, None, None
        self.load_state()
        self.show_message(("✓ Signed out — paste a session to connect again" if action == "session"
                           else "✓ Google Calendar unlinked") if ok else
                          f"Couldn't clear: {(result.stdout or result.stderr).strip()}", "ok" if ok else "error")
        self.render()

    def set_up_calendar(self, *args):
        subprocess.Popen([CLI, "set-calendar", "--window"], start_new_session=True)
        self.hide()

    def add_note(self):
        text = self.note_field.get_text().strip()
        if not self.busy and text:
            self.run_cli(["add-note", self.day_iso, text], "note")

    def open_web_app(self, *args):
        subprocess.Popen(["xdg-open", WEB_APP], start_new_session=True)
        self.hide()

    def paste_session(self, *args):
        subprocess.Popen([CLI, "set-session", "--window"], start_new_session=True)
        self.hide()

    def run_cli(self, args, action, summary=""):
        """Run timur-bar off the UI thread. action None = background refresh (errors show in the header)."""
        if self.pending is not None:
            return False
        self.pending = (action, summary)
        if action:
            self.undo = None  # Undo only follows the delete directly
            self.busy = True
            self.show_message("Saving…")
            self.render()

        def work():
            result = subprocess.run([CLI, *args], capture_output=True, text=True)
            try:
                parsed = json.loads(result.stdout.strip().splitlines()[-1])
            except (ValueError, IndexError):
                parsed = {"ok": False, "error": (result.stderr or "Unexpected output from timur-bar").strip()}
            GLib.idle_add(self.finish_cli, parsed)

        threading.Thread(target=work, daemon=True).start()
        return True

    def refresh(self):
        """Background refresh that also fetches the day on screen (the timer only keeps today and yesterday)."""
        if self.run_cli(["refresh", "--date", self.day_iso], None):
            self.fetched.add(self.day_iso)

    def finish_cli(self, result):
        action, summary = self.pending
        self.pending = None
        self.busy = False
        if action is None and result.get("ok"):
            self.fetched.clear()
        self.load_state()
        if action is None:
            return False
        if not result.get("ok"):
            prefix = "Not saved — " if result.get("errorKind") == "network" else ""
            self.show_message(f"{prefix}{result.get('error') or 'Save failed'}. Your input is kept.",
                              "auth" if result.get("errorKind") == "auth" else "error")
            self.render()
            return False
        task = self.task_label_for(self.selected_task) or self.editing_task_label
        minutes = parse_duration(self.duration_field.get_text())
        what = format_minutes(minutes) if minutes else self.entry_status
        if action in ("entry", "update"):
            text = (f"Logged {what} to {task}" if minutes else f"Added {what} · {task}") if action == "entry" \
                else f"Updated {what} · {task}"
            notify(text, "appointment-new" if action == "entry" else "document-edit")
            self.editing_id = self.editing_task_label = ""
            self.entry_status = "DONE"
            self.duration_field.set_text("")
            self.description_field.set_text("")
            self.task_field.set_text("")
            self.show_message("✓ " + text, "ok")
            self.task_field.grab_focus()
        elif action == "delete":
            notify(f"Deleted {summary}", "edit-delete")
            self.show_message(f"✓ Deleted {summary}", "ok")
            self.undo = self.deleted
            GLib.timeout_add_seconds(UNDO_SECONDS, self.expire_undo, self.undo)
        elif action == "repeat":
            notify(f"Logged {summary} again today")
            self.show_message(f"✓ Logged {summary} again today", "ok")
        elif action == "undo":
            notify(f"Restored {summary}", "edit-undo")
            self.show_message(f"✓ Restored {summary}", "ok")
        elif action == "meetings":
            notify(f"Logged {summary}")
            self.show_message(f"✓ Logged {summary}", "ok")
        elif action == "copy":
            notify(f"Copied {summary} to today")
            self.show_message(f"✓ Copied {summary} to today", "ok")
        elif action == "note":
            self.note_field.set_text("")
            self.render_journal_hint(f"✓ Added to {self.day_name.lower()}'s journal", "ok")
            self.note_field.grab_focus()
        self.render()
        return False

    # ---------------------------------------------------------------- show / hide

    def keep_on_monitor(self, *args):
        """Pin the panel's top-right corner to the anchor. The real width is often more than WIDTH
        (fonts, long labels), so placing it by WIDTH let it spill onto the monitor to the right."""
        if self.anchor:
            right, top = self.anchor
            x = right - self.get_size()[0] - EDGE_GAP
            if self.get_position() != (x, top):
                self.move(x, top)

    def present_at_top_right(self):
        display = Gdk.Display.get_default()
        _, x, y = display.get_default_seat().get_pointer().get_position()
        geo = display.get_monitor_at_point(x, y).get_geometry()
        self.anchor = (geo.x + geo.width, geo.y + TOP_OFFSET)
        self.screen_height = geo.height - TOP_OFFSET - EDGE_GAP
        self.keep_on_monitor()
        self.show()
        self.present_with_time(Gdk.CURRENT_TIME)
        self.keep_on_monitor()  # again after map: some WMs ignore the first
        self.show_message("")
        self.render()
        self.focus_tab()
        self.refresh()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.togglecorp.TimurPanel",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None

    def do_startup(self):
        Gtk.Application.do_startup(self)  # the stylesheet comes with the Panel's Appearance

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        tab = "journal" if "journal" in args else "entry"
        first = self.window is None
        if first:
            self.window = Panel(self)
            if "--yesterday" in args:
                self.window.set_day(-1)
        win = self.window
        if not first and win.get_visible() and win.tab == tab:
            win.hide()  # same shortcut again closes it
            return 0
        if win.tab != tab:
            win.set_tab(tab)
        if not win.get_visible():
            win.present_at_top_right()
        else:
            win.present_with_time(Gdk.CURRENT_TIME)
            win.focus_tab()
        return 0


if __name__ == "__main__":
    GLib.set_prgname("timur-panel")  # X11 class "Timur-panel", used by the i3 for_window rule
    sys.exit(App().run(sys.argv))
